{# Formatting template only. Run schema + semantic checks before rendering. No extraction is performed here. #}
{%- set status_labels = {'confirmed':'확인된 값','candidate':'모델·구간 검증이 필요한 후보','on_hold':'조건 확인 전 보류','no_measurement':'필요한 측정 없음'} -%}
{%- macro sources_md(refs) -%}
{%- for sid in refs -%}
{%- if sid in sources -%}
{%- set s = sources[sid] -%}
{% if not loop.first %} · {% endif %}{% if s.link_validated and s.raw_path %}[{{ s.label }}](<{{ s.raw_path }}>){% else %}{{ s.label }} (원본 링크 확인 전){% endif %}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro value_md(r) -%}
{{ r.relation or '' }}{{ r.get('display_value') if r.get('display_value') is not none else r.value }} {{ r.unit }}{% if r.value_kind in ['lower_bound','upper_bound'] %} ({{ '하한' if r.value_kind == 'lower_bound' else '상한' }}){% endif %}
{%- endmacro -%}
{%- macro figure_md(fid, level='###') %}
{% if fid in figures and figures[fid].state == 'ready' and figures[fid].render_verified %}
{% set f = figures[fid] %}
{{ level }} {{ f.title }}

![{{ f.title }} — {{ f.x_axis }} / {{ f.y_axis }}](<{{ f.image_path }}>)

**그림 설명.** {{ f.caption.observation }} {{ f.caption.conditions }}{% if f.caption.limitation %} {{ f.caption.limitation }}{% endif %}

**자료:** {{ sources_md(f.source_refs) }} · [그림의 원본·추출 수치](<{{ f.plot_data_path }}>)
{% endif %}
{% endmacro -%}
{%- set selected = namespace(fet=[], drain=[], raw=[], hero=None, headlines=[]) -%}
{%- if summary.hero_figure_id in figures and figures[summary.hero_figure_id].state == 'ready' and figures[summary.hero_figure_id].render_verified -%}
{%- set selected.hero = summary.hero_figure_id -%}
{%- endif -%}
{%- for fid in layout.raw_figure_ids -%}
{%- if fid in figures and figures[fid].state == 'ready' and figures[fid].render_verified and fid != selected.hero -%}
{%- set selected.raw = selected.raw + [fid] -%}
{%- endif -%}
{%- endfor -%}
{%- for group, ids in [('fet',layout.fet_module_ids),('drain',layout.drain_module_ids)] -%}
{%- for mid in ids if mid in modules -%}
{%- set m = modules[mid] -%}
{%- set check = namespace(result_count=0, figure_count=0) -%}
{%- for rk,r in m.results.items() -%}
{%- if r.display_approved and r.status in ['confirmed','candidate'] and r.value is not none -%}
{%- set check.result_count = check.result_count + 1 -%}
{%- endif -%}
{%- endfor -%}
{%- for fid in m.figure_ids -%}
{%- if fid in figures and figures[fid].state == 'ready' and figures[fid].render_verified -%}
{%- set check.figure_count = check.figure_count + 1 -%}
{%- endif -%}
{%- endfor -%}
{%- if m.display_approved and m.status in ['confirmed','candidate'] and check.result_count > 0 and check.figure_count > 0 and (group != 'drain' or device.analysis_context == 'drain_fold') -%}
{%- if group == 'fet' -%}{%- set selected.fet = selected.fet + [mid] -%}
{%- else -%}{%- set selected.drain = selected.drain + [mid] -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- for item in summary.headline_metrics -%}
{%- if item.module_id in modules and item.result_key in modules[item.module_id].results -%}
{%- set r=modules[item.module_id].results[item.result_key] -%}
{%- if r.status == 'confirmed' and r.display_approved and r.value is not none and (item.module_id in selected.fet or item.module_id in selected.drain) -%}
{%- set selected.headlines=selected.headlines+[r] -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
---
type: fet-research-report
profile: {{ report.profile }}
template_version: "{{ report.template_version }}"
report_format: fet-template-report-1
analysis_version: {{ report.analysis_version|tojson }}
metadata_status: {{ report.get('metadata_status')|tojson }}
device_name: {{ device.name|tojson }}
metadata_review_required: {{ report.get('metadata_review_required', true)|tojson }}
measurement_date: {{ report.get('measurement_date')|tojson }}
tags:
  - research/fet
---

